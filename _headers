# HTTP security headers. Cloudflare (the site runs as a Worker with static assets) applies this
# file to every page it serves; Cloudflare Pages and Netlify read it too, other hosts ignore it.
# The pages' own <meta> Content-Security-Policy does the rest; these are the headers a meta
# tag can't set. frame-ancestors / X-Frame-Options stop other sites showing this one in a frame.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# The font files never change (a new version would get a new name), so browsers can keep them
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images rarely change, but keep their names when they do, so they're kept for a day and
# quietly refreshed in the background for a week after that. (CSS, JS and pages keep the
# host's default: checked on every visit, so an update shows straight away.)
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Duplicate copies: the Worker's own workers.dev and preview addresses would serve this same
# site. Keep them switched off (Worker → Settings → Domains & Routes) so only www.cobwebz.lk
# is ever crawled.
